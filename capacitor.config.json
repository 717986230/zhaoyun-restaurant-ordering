{
  "appId": "at.zhaoyun.restaurant.ordering",
  "appName": "Chiri Kitchen POS",
  "webDir": "dist/web",
  "server": {
    "url": "https://ck.uuoo.workers.dev/pos.html",
    "cleartext": false,
    "allowNavigation": [
      "ck.uuoo.workers.dev"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#090807"
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
