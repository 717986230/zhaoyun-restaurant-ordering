HOST=0.0.0.0
PORT=8787
ADMIN_TOKEN=replace-with-a-long-random-token
NODE_ENV=development
# Production may set a comma-separated allow-list, for example https://admin.example.com
CORS_ORIGIN=
DATABASE_PATH=./server/data/restaurant.sqlite
UPLOAD_DIR=./server/uploads
BACKUP_DIR=./server/backups
# API 服务和每个打印代理共用同一个 SQLite 文件，写锁冲突时等待的毫秒数。
SQLITE_BUSY_TIMEOUT_MS=5000
# 公开下单/服务呼叫接口的限流窗口和上限（按客户端 IP）。
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_MAX=60
SERVICE_RATE_LIMIT_MAX=20
# Start one server-side LAN agent per print station.
PRINTER_ROLE=kitchen
PRINT_AGENT_ID=kitchen-01
PRINT_POLL_MS=1500
