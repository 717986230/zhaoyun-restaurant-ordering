HOST=0.0.0.0
PORT=8787
ADMIN_TOKEN=replace-with-a-long-random-token
NODE_ENV=development
# Production may set a comma-separated allow-list, for example https://admin.example.com
CORS_ORIGIN=
# Required behind a reverse proxy so auth rate limiting sees the real client IP.
# Comma-separated addresses/subnets of the trusted proxies themselves, e.g. 127.0.0.1 or
# 10.0.0.0/8. Hop counts and `true` are rejected at startup: they do not resolve a client.
TRUST_PROXY=
DATABASE_PATH=./server/data/restaurant.sqlite
UPLOAD_DIR=./server/uploads
BACKUP_DIR=./server/backups
# Start one server-side LAN agent per print station.
PRINTER_ROLE=kitchen
PRINT_AGENT_ID=kitchen-01
PRINT_POLL_MS=1500
