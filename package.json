{
  "name": "austria-restaurant-ordering-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Capacitor Android app for an offline restaurant ordering table system.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "server:test": "node --test server/tests/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "unit": "vitest run",
    "test": "playwright test",
    "test:ui": "playwright test --headed",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "package:source": "zip -FS -r dist/zhaoyun-ordering-v0.3.0-source.zip . -x 'node_modules/*' '.npm-cache/*' 'android/.gradle/*' 'android/app/build/*' 'android/capacitor-cordova-android-plugins/build/*' 'android/local.properties' 'server/data/*' 'server/uploads/*' 'dist/*' 'apps/*/dist/*' 'packages/*/dist/*' 'apps/*/tsconfig.tsbuildinfo' 'packages/*/tsconfig.tsbuildinfo' 'test-results/*' 'playwright-report/*' 'sources/*' 'AGENTS.md' '.git/*' '.DS_Store'"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@sinclair/typebox": "^0.34.38",
    "@tanstack/react-query": "^5.83.0",
    "fastify": "^5.11.0",
    "motion": "^12.43.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@playwright/test": "^1.46.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.2",
    "vitest": "^3.2.4"
  }
}
