{
  "name": "austria-restaurant-ordering-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Capacitor Android app for an offline restaurant ordering table system.",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "server:test": "node --test server/tests/*.test.mjs",
    "build": "vite build",
    "test": "playwright test",
    "test:ui": "playwright test --headed",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "package:source": "zip -FS -r dist/austria-restaurant-ordering-app-source.zip . -x 'node_modules/*' '.npm-cache/*' 'android/.gradle/*' 'android/app/build/*' 'android/capacitor-cordova-android-plugins/build/*' 'android/local.properties' 'server/data/*' 'server/uploads/*' 'dist/*' 'test-results/*' 'playwright-report/*' '.git/*' '.DS_Store'"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@playwright/test": "^1.46.1",
    "vite": "^5.4.2"
  }
}
